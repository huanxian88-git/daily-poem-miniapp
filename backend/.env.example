# ===========
# 天天半首诗 - 后端环境变量配置
# ===========
# 复制此文件为 .env 并填写真实值
# 注意：.env 已在 .gitignore 中，不会提交到仓库
# ===========

# ------- 微信小程序 -------
# 小程序后台 → 开发管理 → 开发设置 → AppSecret
WECHAT_APPID=wxc715f5de1dee100
WECHAT_APPSECRET=your_wechat_app_secret_here


# ------- 数据库 -------
# 本地开发（Docker）：postgresql+asyncpg://dailyapp:localdev@localhost:5432/daily_poem
# 腾讯云 TDSQL-C：postgresql+asyncpg://user:pass@host:5432/daily_poem
DATABASE_URL=postgresql+asyncpg://dailyapp:localdev@localhost:5432/daily_poem


# ------- Redis -------
# 本地开发（Docker）：redis://localhost:6379/0
# 腾讯云 Redis：redis://:password@host:6379/0
REDIS_URL=redis://localhost:6379/0


# ------- JWT -------
# 用于签发/验证用户 Token，生产环境必须更换为随机长字符串
# 生成方式：openssl rand -hex 32
JWT_SECRET=change-me-in-production!!!
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080


# ------- 腾讯混元大模型 -------
HUNYUAN_API_KEY=your_hunyuan_api_key_here
HUNYUAN_MODEL=hunyuan-lite


# ------- 腾讯云 ASR 语音识别 + COS 对象存储 -------
TENCENT_SECRET_ID=your_tencent_secret_id_here
TENCENT_SECRET_KEY=your_tencent_secret_key_here
TENCENT_APPID=1305326598

# COS 配置（存储 AI 场景图片）
COS_BUCKET=daily-poem-images-1305326598
COS_REGION=ap-guangzhou


# ------- 环境标识 -------
# development / staging / production
APP_ENV=development
DEBUG=true
