# 天天半首诗 后端开发环境配置
# ===================================
# 复制此文件为 .env 后填入实际值
# cp .env.example .env

# 开发模式：Mock 微信登录，无需真实 AppSecret
DEV_MODE=True
DEBUG=True

# 数据库（SQLite 开发库）
DATABASE_URL=sqlite+aiosqlite:///./data/daily_poem.db

# Redis（开发环境可降级）
REDIS_URL=redis://localhost:6379/0
REDIS_GRACEFUL_DEGRADATION=True

# 微信小程序（DEV_MODE 下无需填写）
WECHAT_APPID=wxcb715f5de1dee100
WECHAT_SECRET=

# JWT（开发环境使用默认值，生产环境必须更换）
JWT_SECRET=dev-only-change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256

# 腾讯混元（阶段5启用）
HUNYUAN_API_KEY=
HUNYUAN_API_URL=https://hunyuan.tencentcloudapi.com

# 腾讯云 ASR（阶段5启用）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_ASR_REGION=ap-guangzhou
TENCENT_APPID=

# 腾讯云 COS（阶段5启用）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=

# CORS
CORS_ORIGINS=["*"]
