# ===========
# 天天半首诗 - 后端环境变量配置
# ===========
# 复制此文件为 .env 并填写真实值
# 注意：.env 已在 .gitignore 中，不会提交到仓库
# ===========

# App
APP_NAME=天天半首诗
APP_VERSION=0.1.0
DEBUG=True

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=daily_poem
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# WeChat Mini Program
WX_APPID=wxcb715f5de1dee100
WX_SECRET=your_wx_secret

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
