/* pages/review/review.wxss - 临帖（复习）页 */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: var(--safe-bottom);
}

.loading-wrap {
  padding: var(--spacing-lg);
}

/* 区块标题 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-lg) var(--spacing-md) var(--spacing-sm);
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text);
}

.section-count {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

/* 复习卡片 */
.review-card {
  margin: var(--spacing-sm) var(--spacing-md);
  background: var(--color-white);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg) var(--spacing-md);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.review-card.urgent {
  border-left: 6rpx solid var(--color-accent);
}

/* 紧急度标记 */
.urgency-badge {
  position: absolute;
  top: var(--spacing-sm);
  right: var(--spacing-sm);
  background: var(--color-accent);
  border-radius: var(--radius-sm);
  padding: 2rpx 12rpx;
}

.urgency-text {
  font-size: var(--font-size-xs);
  color: var(--color-white);
  font-weight: 500;
}

/* 诗词信息 */
.review-info {
  flex: 1;
  margin-bottom: var(--spacing-md);
}

.review-title {
  display: block;
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-primary);
  margin-bottom: 4rpx;
}

.review-author {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-xs);
}

.review-date {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}

/* 自评按钮 */
.self-assess {
  display: flex;
  gap: var(--spacing-sm);
}

.assess-btn {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  border-radius: var(--radius-md);
  font-size: var(--font-size-sm);
  transition: all 0.2s var(--ease-out);
}

.assess-btn.easy {
  background: rgba(93, 138, 107, 0.1);
  color: var(--color-success);
  border: 1rpx solid rgba(93, 138, 107, 0.3);
}

.assess-btn.ok {
  background: rgba(196, 162, 101, 0.1);
  color: var(--color-secondary);
  border: 1rpx solid rgba(196, 162, 101, 0.3);
}

.assess-btn.hard {
  background: rgba(196, 69, 54, 0.08);
  color: var(--color-accent);
  border: 1rpx solid rgba(196, 69, 54, 0.2);
}

.assess-btn:active {
  opacity: 0.7;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl) 0;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: var(--spacing-md);
}

.empty-text {
  font-size: var(--font-size-lg);
  color: var(--color-text);
  margin-bottom: var(--spacing-xs);
}

.empty-sub {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}
