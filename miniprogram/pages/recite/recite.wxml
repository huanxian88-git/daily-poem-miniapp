<!--pages/recite/recite.wxml - 吟诵Tab升级-->
<scroll-view class="page" scroll-y enable-flex refresher-enabled bindrefresherrefresh="onPullDownRefresh">

  <!-- 加载态 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="skeleton" style="height: 140rpx; margin-bottom: 24rpx;"></view>
    <view class="skeleton" style="height: 140rpx; margin-bottom: 24rpx;"></view>
    <view class="skeleton" style="height: 140rpx;"></view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{!loading && recitations.length === 0}}">
    <text class="empty-icon">📜</text>
    <text class="empty-text">还没有在背的诗</text>
    <text class="empty-sub">去首页选一首开始吧</text>
    <button class="action-btn primary" bindtap="goToIndex">去选诗</button>
  </view>

  <!-- 在背列表 -->
  <block wx:elif="{{recitations.length > 0}}">
    <view class="section-header">
      <text class="section-title">在背 {{recitations.length}} 首</text>
    </view>

    <view
      class="recite-card"
      wx:for="{{recitations}}"
      wx:key="recitation_id"
      bindtap="goToReciteCheck"
      data-id="{{item.recitation_id}}"
      data-poem-id="{{item.poem_id}}"
      data-title="{{item.title}}"
    >
      <!-- 诗名 -->
      <view class="recite-card-header">
        <text class="recite-title">{{item.title}}</text>
        <text class="recite-author">〔{{item.dynasty}}〕{{item.author}}</text>
      </view>

      <!-- 三关进度 -->
      <view class="recite-progress">
        <view class="progress-item {{item.fill_score !== null ? 'done' : ''}}">
          <view class="progress-dot">
            <text wx:if="{{item.fill_score !== null}}">{{item.fill_score >= 60 ? '✓' : '✗'}}</text>
            <text wx:else>1</text>
          </view>
          <text class="progress-label">补阙</text>
          <text class="progress-score" wx:if="{{item.fill_score !== null}}">{{item.fill_score}}分</text>
        </view>
        <view class="progress-connector {{item.sort_score !== null ? 'done' : ''}}"></view>
        <view class="progress-item {{item.sort_score !== null ? 'done' : ''}}">
          <view class="progress-dot">
            <text wx:if="{{item.sort_score !== null}}">{{item.sort_score >= 60 ? '✓' : '✗'}}</text>
            <text wx:else>2</text>
          </view>
          <text class="progress-label">排序</text>
          <text class="progress-score" wx:if="{{item.sort_score !== null}}">{{item.sort_score}}分</text>
        </view>
        <view class="progress-connector {{item.voice_score !== null ? 'done' : ''}}"></view>
        <view class="progress-item {{item.voice_score !== null ? 'done' : ''}}">
          <view class="progress-dot">
            <text wx:if="{{item.voice_score !== null}}">{{item.voice_score >= 60 ? '✓' : '✗'}}</text>
            <text wx:else>3</text>
          </view>
          <text class="progress-label">背诵</text>
          <text class="progress-score" wx:if="{{item.voice_score !== null}}">{{item.voice_score}}分</text>
        </view>
      </view>
    </view>
  </block>

</scroll-view>
