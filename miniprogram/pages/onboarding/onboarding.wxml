<!--pages/onboarding/onboarding.wxml - 用户画像采集页-->
<view class="page">

  <!-- 进度指示 -->
  <view class="progress-bar">
    <view class="progress-step {{step >= 1 ? 'active' : ''}} {{step > 1 ? 'done' : ''}}">
      <text class="step-num">1</text>
      <text class="step-label">年龄</text>
    </view>
    <view class="progress-line {{step > 1 ? 'active' : ''}}"></view>
    <view class="progress-step {{step >= 2 ? 'active' : ''}} {{step > 2 ? 'done' : ''}}">
      <text class="step-num">2</text>
      <text class="step-label">水平</text>
    </view>
    <view class="progress-line {{step > 2 ? 'active' : ''}}"></view>
    <view class="progress-step {{step >= 3 ? 'active' : ''}} {{step > 3 ? 'done' : ''}}">
      <text class="step-num">3</text>
      <text class="step-label">身份</text>
    </view>
  </view>

  <!-- 第1步：年龄段 -->
  <view class="step-content" wx:if="{{step === 1}}">
    <view class="step-title">你处于人生哪一段？</view>
    <view class="step-subtitle">不同阶段，诗有不同的意味</view>
    <view class="option-grid">
      <view
        class="option-card {{selectedAgeGroup === item.value ? 'selected' : ''}}"
        wx:for="{{ageGroupOptions}}"
        wx:key="value"
        bindtap="selectAgeGroup"
        data-value="{{item.value}}"
      >
        <text class="option-icon">{{item.icon}}</text>
        <text class="option-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 第2步：诗词水平+兴趣 -->
  <view class="step-content" wx:if="{{step === 2}}">
    <view class="step-title">你与诗词的缘分？</view>
    <view class="step-subtitle">让我们为你选更合适的诗</view>

    <!-- 诗词水平 -->
    <view class="sub-section">
      <text class="sub-title">诗词水平</text>
      <view class="option-row">
        <view
          class="option-pill {{selectedLevel === item.value ? 'selected' : ''}}"
          wx:for="{{levelOptions}}"
          wx:key="value"
          bindtap="selectLevel"
          data-value="{{item.value}}"
        >
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 兴趣偏好 -->
    <view class="sub-section">
      <text class="sub-title">兴趣偏好（可多选）</text>
      <view class="option-row wrap">
        <view
          class="option-pill {{selectedInterests.indexOf(item.value) > -1 ? 'selected' : ''}}"
          wx:for="{{interestOptions}}"
          wx:key="value"
          bindtap="toggleInterest"
          data-value="{{item.value}}"
        >
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 第3步：是否学生 -->
  <view class="step-content" wx:if="{{step === 3}}">
    <view class="step-title">你是在校学生吗？</view>
    <view class="step-subtitle">学生可绑定课本，按教学进度推荐</view>

    <view class="option-row center">
      <view
        class="option-card-lg {{isStudent === true ? 'selected' : ''}}"
        bindtap="selectStudent"
        data-value="true"
      >
        <text class="option-icon">📖</text>
        <text class="option-label">是，我是学生</text>
      </view>
      <view
        class="option-card-lg {{isStudent === false ? 'selected' : ''}}"
        bindtap="selectStudent"
        data-value="false"
      >
        <text class="option-icon">🌿</text>
        <text class="option-label">不是，自由选诗</text>
      </view>
    </view>

    <!-- 课本选择（学生才显示） -->
    <view class="sub-section" wx:if="{{isStudent}}">
      <text class="sub-title">课本版本</text>
      <picker
        mode="selector"
        range="{{textbookVersions}}"
        bindchange="onTextbookVersionChange"
      >
        <view class="picker-display">
          <text>{{selectedTextbook || '请选择课本版本'}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>

      <text class="sub-title" style="margin-top: 24rpx;">年级</text>
      <picker
        mode="selector"
        range="{{gradeOptions}}"
        bindchange="onGradeChange"
      >
        <view class="picker-display">
          <text>{{selectedGrade || '请选择年级'}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>

      <text class="sub-title" style="margin-top: 24rpx;">学期</text>
      <view class="option-row">
        <view
          class="option-pill {{selectedSemester === '上册' ? 'selected' : ''}}"
          bindtap="selectSemester"
          data-value="上册"
        >
          <text>上册</text>
        </view>
        <view
          class="option-pill {{selectedSemester === '下册' ? 'selected' : ''}}"
          bindtap="selectSemester"
          data-value="下册"
        >
          <text>下册</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar safe-bottom">
    <view class="skip-btn" bindtap="skipStep">
      <text>{{step < 3 ? '跳过' : '跳过全部'}}</text>
    </view>
    <view class="next-btn {{canNext ? 'active' : ''}}" bindtap="nextStep">
      <text>{{step < 3 ? '下一步' : '完成'}}</text>
    </view>
  </view>

</view>
