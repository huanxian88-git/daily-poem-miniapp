<!--pages/index/index.wxml-->
<scroll-view
  class="page"
  scroll-y
  enable-flex
  refresher-enabled
  bindrefresherrefresh="onPullDownRefresh"
>

  <!-- 加载态 -->
  <view class="poem-card" wx:if="{{loading}}">
    <view class="skeleton" style="height: 320rpx; margin-bottom: 24rpx;"></view>
    <view class="skeleton" style="height: 40rpx; width: 60%; margin-bottom: 16rpx;"></view>
    <view class="skeleton" style="height: 28rpx; width: 80%; margin-bottom: 8rpx;"></view>
    <view class="skeleton" style="height: 28rpx; width: 40%;"></view>
  </view>

  <!-- 未登录态 -->
  <view class="empty-state" wx:elif="{{!isLoggedIn && !loading}}">
    <text class="empty-text">点击下方按钮登录，开始每日读诗</text>
    <button class="action-btn primary" bindtap="login">微信登录</button>
  </view>

  <!-- 推荐内容 -->
  <block wx:elif="{{poem}}">
    <!-- 日期 + 推荐理由 -->
    <view class="date-reason">
      <text class="date-text">{{todayDate}}</text>
      <text class="reason-text" wx:if="{{reason}}">{{reason}}</text>
    </view>

    <!-- AI场景图 -->
    <view class="scene-image" wx:if="{{sceneImage}}">
      <image src="{{sceneImage}}" mode="aspectFill" lazy-load />
    </view>

    <!-- 诗词卡片 -->
    <view class="poem-card">
      <!-- 正文 -->
      <view class="poem-content" bindtap="viewPoemDetail">
        {{poem.content}}
      </view>

      <!-- 标题/作者 -->
      <view class="poem-meta" bindtap="viewPoemDetail">
        <text class="poem-title">{{poem.title}}</text>
        <text class="poem-author">〔{{poem.dynasty}}〕{{poem.author}}</text>
        <text class="poem-difficulty">{{stars}}</text>
      </view>

      <!-- 展开指示器 -->
      <view class="expand-hint" bindtap="viewPoemDetail">
        <text>▼ 查看注释译文</text>
      </view>
    </view>

    <!-- 操作栏 -->
    <view class="action-bar">
      <view class="action-btn" bindtap="switchPoem">
        <text wx:if="{{canSwitch}}">另择</text>
        <text wx:else style="color: var(--color-disabled)">今日已满</text>
      </view>
      <view class="action-btn" bindtap="toggleFavorite">珍藏</view>
      <view class="action-btn primary" bindtap="startRecite">吟诵 · 开始背诵</view>
    </view>

    <!-- 零压力提示 -->
    <view class="zero-pressure-hint">今日鉴赏，不背也美</view>
  </block>

  <!-- 错误态 -->
  <view class="empty-state" wx:elif="{{error}}">
    <text class="empty-text">{{error}}</text>
    <button class="action-btn primary" bindtap="fetchTodayRecommendation">重试</button>
  </view>

</scroll-view>
