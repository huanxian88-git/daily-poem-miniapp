<!--pages/profile/profile.wxml - 我的Tab升级-->
<scroll-view class="page" scroll-y enable-flex>

  <!-- 未登录 -->
  <view class="login-section" wx:if="{{!isLoggedIn}}">
    <view class="login-prompt">
      <text class="login-icon">📜</text>
      <text class="login-text">登录后，记录你的诗词之旅</text>
    </view>
    <button class="action-btn primary" bindtap="handleLogin">微信登录</button>
  </view>

  <!-- 已登录 -->
  <block wx:else>
    <!-- 用户卡片 -->
    <view class="user-card">
      <image class="user-avatar" src="{{userInfo.avatarUrl || '/assets/default-avatar.png'}}" mode="aspectFill" />
      <view class="user-info">
        <text class="user-name">{{userInfo.nickname || '诗友'}}</text>
        <text class="user-profile-tag" wx:if="{{profileTag}}">{{profileTag}}</text>
      </view>
    </view>

    <!-- 统计摘要 -->
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-num">{{stats.masteredCount || 0}}</text>
        <text class="stat-label">已背</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{stats.streakDays || 0}}</text>
        <text class="stat-label">连续天</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{stats.totalRecited || 0}}</text>
        <text class="stat-label">总尝试</text>
      </view>
    </view>

    <!-- 画像信息 -->
    <view class="info-card">
      <view class="info-row">
        <text class="info-label">年龄段</text>
        <text class="info-value">{{profileDisplay.ageGroup || '未设置'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">诗词水平</text>
        <text class="info-value">{{profileDisplay.level || '未设置'}}</text>
      </view>
      <view class="info-row" wx:if="{{userProfile.isStudent}}">
        <text class="info-label">课本</text>
        <text class="info-value">{{profileDisplay.textbook || '未绑定'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">背诵节奏</text>
        <text class="info-value">{{profileDisplay.rhythm || '每2天'}}</text>
      </view>
    </view>

    <!-- 设置项 -->
    <view class="settings-card">
      <view class="setting-item" bindtap="goToOnboarding">
        <text class="setting-label">修改画像</text>
        <text class="setting-arrow">›</text>
      </view>
      <view class="setting-item" bindtap="showRhythmPicker">
        <text class="setting-label">背诵节奏</text>
        <text class="setting-value">{{profileDisplay.rhythm || '每2天'}}</text>
        <text class="setting-arrow">›</text>
      </view>
      <view class="setting-item" bindtap="showAbout">
        <text class="setting-label">关于</text>
        <text class="setting-arrow">›</text>
      </view>
    </view>

    <!-- 退出登录 -->
    <view class="logout-section">
      <button class="logout-btn" bindtap="handleLogout">退出登录</button>
    </view>
  </block>

  <!-- 背诵节奏Picker -->
  <picker
    wx:if="{{showRhythm}}"
    mode="selector"
    range="{{rhythmOptions}}"
    range-key="label"
    bindchange="onRhythmChange"
    bindcancel="onRhythmCancel"
  >
    <view></view>
  </picker>

</scroll-view>
