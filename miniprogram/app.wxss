/**
 * 全局样式 - 每日背诗小程序
 * 设计规范：新中式·克制，月白底 + 深青主色 + 松绿点缀
 */

/* ===== CSS 变量（设计 Token） ===== */
page {
  /* 色彩 */
  --color-bg: #FAFAF5;          /* 月白底 */
  --color-primary: #2C3E50;     /* 深青 */
  --color-accent: #5D8A6B;      /* 松绿 */
  --color-gold: #9A8A6A;        /* 淡金 */
  --color-text: #2C3E50;        /* 主文字 */
  --color-text-secondary: #7A8A9A; /* 次级文字 */
  --color-text-muted: #B0B8C0;  /* 弱化文字 */
  --color-border: #E8E4DD;      /* 分割线 */
  --color-white: #FFFFFF;
  --color-error: #C0644A;       /* 错误/警告（琥珀色，非正红） */
  --color-success: #5D8A6B;     /* 成功（复用松绿） */

  /* 互动态 */
  --color-hover: rgba(44, 62, 80, 0.04);
  --color-pressed: rgba(44, 62, 80, 0.08);
  --color-disabled: #C0C8D0;

  /* 字体 */
  --font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', sans-serif;
  --font-poem: 'Source Han Serif SC', 'Noto Serif CJK SC', 'SimSun', serif;
  --font-size-xs: 22rpx;
  --font-size-sm: 26rpx;
  --font-size-base: 30rpx;
  --font-size-lg: 34rpx;
  --font-size-xl: 38rpx;
  --font-size-xxl: 42rpx;

  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;

  /* 阴影 */
  --shadow-sm: 0 2rpx 12rpx rgba(44, 62, 80, 0.06);
  --shadow-md: 0 4rpx 20rpx rgba(44, 62, 80, 0.08);

  /* 动效 */
  --ease-out: cubic-bezier(0.4, 0, 0.2, 1);

  /* 安全区 */
  --safe-bottom: env(safe-area-inset-bottom, 0);

  /* 全局背景 */
  background-color: var(--color-bg);
  color: var(--color-text);
  font-family: var(--font-body);
  font-size: var(--font-size-base);
  line-height: 1.6;
}

/* ===== 通用组件样式 ===== */

/* 诗词正文 */
.poem-content {
  font-family: var(--font-poem);
  font-size: var(--font-size-xl);
  line-height: 2.0;
  letter-spacing: 2rpx;
  color: var(--color-text);
  padding: var(--spacing-xl) 0 var(--spacing-md);
  text-align: center;
  user-select: none;
}

/* 诗词卡片 */
.poem-card {
  background: var(--color-white);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg) var(--spacing-md);
  margin: var(--spacing-md);
  box-shadow: var(--shadow-sm);
}

/* AI场景图 */
.scene-image {
  width: 100%;
  border-radius: var(--radius-md) var(--radius-md) 0 0;
  overflow: hidden;
}

.scene-image image {
  width: 100%;
  height: 320rpx;
  object-fit: cover;
  display: block;
}

/* 操作栏 */
.action-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-md) 0;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 12rpx 28rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-size-sm);
  border: 1rpx solid var(--color-border);
  background: var(--color-white);
  color: var(--color-text-secondary);
  transition: all 0.2s var(--ease-out);
}

.action-btn:active {
  background: var(--color-pressed);
}

.action-btn.primary {
  background: var(--color-primary);
  color: var(--color-white);
  border-color: var(--color-primary);
  font-size: var(--font-size-base);
  padding: 16rpx 40rpx;
}

/* 卡片标题 */
.card-title {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-sm);
  letter-spacing: 2rpx;
}

/* 底部安全区 */
.safe-bottom {
  padding-bottom: var(--safe-bottom);
}

/* 空态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl) var(--spacing-lg);
  color: var(--color-text-muted);
}

.empty-state .empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: var(--spacing-md);
  opacity: 0.3;
}

.empty-state .empty-text {
  font-size: var(--font-size-sm);
  margin-bottom: var(--spacing-md);
}

/* 加载态 - shimmer骨架屏 */
.skeleton {
  background: linear-gradient(
    90deg,
    var(--color-border) 25%,
    #F0ECE6 50%,
    var(--color-border) 75%
  );
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: var(--radius-sm);
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

/* 错误提示（温和风格） */
.error-hint {
  background: rgba(192, 100, 74, 0.08);
  border-left: 4rpx solid var(--color-error);
  padding: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);
  color: var(--color-error);
  margin: var(--spacing-sm) 0;
}
